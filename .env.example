# Copy to .env. Never put secrets in frontend files or commit .env.
PORT=3000
HOST=127.0.0.1
# demo = local deterministic grammar; live = actual independent model calls.
AI_MODE=demo
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
INTENT_MODEL=gpt-6-astra
VALIDATOR_MODEL=gpt-6-astra
TRANSCRIBE_MODEL=gpt-transcribe
# Synthetic sessions are persisted locally, not a production database.
DATA_DIR=./data
